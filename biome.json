{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**", "src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "wxt/browser": "Extension API access belongs in src/platform or entrypoints"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/tokens.css"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" }
        }
      }
    }
  ]
}
