{
  "name": "headershim",
  "version": "0.1.0",
  "description": "Modify HTTP request and response headers with scoped rules and switchable profiles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun279/headershim.git"
  },
  "homepage": "https://github.com/arun279/headershim#readme",
  "bugs": {
    "url": "https://github.com/arun279/headershim/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e:hostaccess": "E2E_HOST_ACCESS=1 wxt build",
    "build:e2e:narrow-hostaccess": "E2E_NARROW_HOST_ACCESS=1 wxt build",
    "icons": "node scripts/render-icons.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:lint": "biome ci . --error-on-warnings",
    "check:types": "tsc --noEmit",
    "check:test": "node scripts/check-coverage.mjs",
    "check:knip": "knip --treat-config-hints-as-errors",
    "check:knip:production": "knip --production --include files --treat-config-hints-as-errors",
    "check:gates": "node --test scripts/gates.test.mjs",
    "check:playwright-projects": "node scripts/check-playwright-projects.mjs",
    "check:fake-browser": "node scripts/check-fake-browser.mjs",
    "check:dup": "jscpd",
    "check:size": "pnpm build && node scripts/check-size-coverage.mjs && size-limit && node scripts/check-size-slack.mjs",
    "check:manifest": "pnpm build && node scripts/manifest-policy.mjs",
    "check:no-network": "pnpm build && node scripts/check-no-network.mjs",
    "check:icons": "node scripts/render-icons.mjs --check",
    "check:overrides": "node scripts/check-overrides.mjs",
    "check:self-contained": "node scripts/check-self-contained.mjs",
    "check:em-dash": "node scripts/check-em-dash.mjs",
    "check:test-classes": "node scripts/check-test-classes.mjs",
    "check:host-access-confinement": "node scripts/check-host-access-confinement.mjs",
    "check": "pnpm check:lint && pnpm check:types && pnpm check:test && pnpm check:knip && pnpm check:knip:production && pnpm check:gates && pnpm check:playwright-projects && pnpm check:fake-browser && pnpm check:dup && pnpm build && node scripts/manifest-policy.mjs && node scripts/check-no-network.mjs && node scripts/check-size-coverage.mjs && size-limit && node scripts/check-size-slack.mjs && pnpm check:icons && pnpm check:overrides && pnpm check:self-contained && pnpm check:em-dash && pnpm check:test-classes && pnpm check:host-access-confinement",
    "size:record": "pnpm build && node scripts/check-size-slack.mjs --record",
    "e2e": "pnpm build && pnpm build:e2e:hostaccess && pnpm build:e2e:narrow-hostaccess && playwright test",
    "verify": "pnpm check && pnpm e2e",
    "zip": "wxt zip && node scripts/check-release-zip.mjs",
    "postinstall": "wxt prepare",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@size-limit/file": "^13.0.3",
    "@tsconfig/strictest": "^2.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.11.2",
    "jscpd": "^5.0.15",
    "knip": "^6.32.2",
    "preact": "^10.29.8",
    "size-limit": "^13.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "wxt": "^0.21.4"
  },
  "size-limit": [
    {
      "name": "Background",
      "path": ".output/chrome-mv3/background.js",
      "limit": "6250 B"
    },
    {
      "name": "Shared UI runtime",
      "path": [
        ".output/chrome-mv3/chunks/brand-*.js",
        ".output/chrome-mv3/chunks/header-errors-*.js",
        ".output/chrome-mv3/chunks/preload-helper-*.js"
      ],
      "limit": "30500 B"
    },
    {
      "name": "Popup initial load",
      "path": [
        ".output/chrome-mv3/popup.html",
        ".output/chrome-mv3/theme-bootstrap.js",
        ".output/chrome-mv3/chunks/*.js",
        "!.output/chrome-mv3/chunks/DeferredPage-*.js",
        "!.output/chrome-mv3/chunks/RuleEditor-*.js",
        "!.output/chrome-mv3/chunks/modheader-*.js",
        "!.output/chrome-mv3/chunks/options-*.js",
        ".output/chrome-mv3/assets/*.css",
        "!.output/chrome-mv3/assets/DeferredPage-*.css",
        "!.output/chrome-mv3/assets/RuleEditor-*.css",
        "!.output/chrome-mv3/assets/options-*.css"
      ],
      "limit": "46000 B"
    },
    {
      "name": "Options initial load",
      "path": [
        ".output/chrome-mv3/options.html",
        ".output/chrome-mv3/theme-bootstrap.js",
        ".output/chrome-mv3/chunks/*.js",
        "!.output/chrome-mv3/chunks/DeferredPage-*.js",
        "!.output/chrome-mv3/chunks/InlineRename-*.js",
        "!.output/chrome-mv3/chunks/RuleEditor-*.js",
        "!.output/chrome-mv3/chunks/focus-*.js",
        "!.output/chrome-mv3/chunks/headerLine-*.js",
        "!.output/chrome-mv3/chunks/modheader-*.js",
        "!.output/chrome-mv3/chunks/popup-*.js",
        ".output/chrome-mv3/assets/*.css",
        "!.output/chrome-mv3/assets/DeferredPage-*.css",
        "!.output/chrome-mv3/assets/RuleEditor-*.css",
        "!.output/chrome-mv3/assets/headerLine-*.css",
        "!.output/chrome-mv3/assets/popup-*.css"
      ],
      "limit": "40250 B"
    },
    {
      "name": "Options rule editor",
      "path": [
        ".output/chrome-mv3/chunks/RuleEditor-*.js",
        ".output/chrome-mv3/assets/RuleEditor-*.css"
      ],
      "limit": "8500 B"
    },
    {
      "name": "Options deferred pages",
      "path": [
        ".output/chrome-mv3/chunks/DeferredPage-*.js",
        ".output/chrome-mv3/assets/DeferredPage-*.css"
      ],
      "limit": "10000 B"
    },
    {
      "name": "ModHeader import",
      "path": ".output/chrome-mv3/chunks/modheader-*.js",
      "limit": "2500 B"
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "spawn-sync"
    ]
  }
}
